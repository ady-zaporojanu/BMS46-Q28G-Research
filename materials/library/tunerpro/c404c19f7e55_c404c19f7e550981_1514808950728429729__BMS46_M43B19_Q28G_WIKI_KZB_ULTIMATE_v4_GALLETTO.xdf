<?xml version='1.0' encoding='utf-8'?>
<XDFFORMAT version="1.80">
  <XDFHEADER>
    <flags>0x1</flags>
    <fileversion>V1</fileversion>
    <deftitle>BMS46 M43B19 Q28G - ULTIMATE WIKI/KZB v4 (Galletto 32KB offsets)</deftitle>
    <description>Ultimate BMS46 XDF for 32KB Galletto/partial files WITHOUT the 0x10 full-calibration header.
Core maps come from the trusted Bms46_32kb_Galletto XDF.
Additional maps are imported from BMS46-Wiki / Ronin enriched XDF with all map addresses corrected by -0x10 to match Galletto partial offsets.
Research/FULL256 entries are added separately and must be verified before editing.</description>
    <author>KZB</author>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="8" sigdigits="2" outputtype="1" signed="0" lsbfirst="0" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x8000" regioncolor="0x0" regionflags="0x0" name="Binary File" desc="This region describes the bin file edited by this XDF" />
    <CATEGORY index="0x0" name="KZB Trusted Core" />
    <CATEGORY index="0x1" name="Ignition" />
    <CATEGORY index="0x2" name="Deceleration" />
    <CATEGORY index="0x3" name="Limiter" />
    <CATEGORY index="0x4" name="Fuel" />
    <CATEGORY index="0x5" name="Idle" />
    <CATEGORY index="0x6" name="Knock" />
    <CATEGORY index="0x7" name="Torque/Load" />
    <CATEGORY index="0x8" name="Lambda/O2" />
    <CATEGORY index="0x9" name="BMS46-Wiki/Ronin Offset-Corrected" />
    <CATEGORY index="0xA" name="Cooling/Fan" />
    <CATEGORY index="0xB" name="Dwell/Voltage" />
    <CATEGORY index="0xC" name="DISA/ASC" />
    <CATEGORY index="0xD" name="RESEARCH / VERIFY" />
    <CATEGORY index="0xE" name="IDENTIFICATION / FULL256" />
  </XDFHEADER>
