      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x6245" vislevel="1" flags="0xC">
    <title>ICV Cold Ambient Entry Threshold</title>
    <description>[BMS46 v0.51 CODE-DERIVED] PROVISIONAL_CAL_CONSUMER_016452 compares Vehicle_Ambient_Temp FF8317 with 0x8B48 to set the cold-ambient idle state; the state is cleared only after ambient temperature exceeds 0x8B48 plus adjacent hysteresis byte 0x8B49. The established temperature scaling is X*0.75-48 degC. Q28G raw 57 -&gt; -5.25 degC. 0x8B49 is retained for the later single-xref/exhaustiveness pass.</description>
    <CATEGORYMEM index="0" category="5" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0xB38" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
