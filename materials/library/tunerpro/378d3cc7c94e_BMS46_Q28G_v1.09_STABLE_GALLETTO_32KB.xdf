    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x610b" vislevel="1" flags="0xC">
    <title>VMax Speed Hysteresis High</title>
    <description>[v1.01 CODE CONFIRMED] Upper VMax hysteresis magnitude. activate_RPM_limiter adds this byte directly to A3B7 before comparing against Vehicle_Speed, which is in the native 1 count = 1 km/h domain. Stock 3 = +3 km/h, giving an upper boundary of 208 km/h around the 205 km/h main threshold. Original Bosch symbol name is unknown.</description>
    <CATEGORYMEM index="0" category="15" />
