  <XDFCONSTANT uniqueid="0xede4">
    <title>UIF Manufacturing Year</title>
    <description>Year decoder; separates the observed year-byte high-bit flag before converting YY to YYYY.
[READ-ONLY DISPLAY]</description>
    <CATEGORYMEM index="0" category="16" />
    <EMBEDDEDDATA mmedaddress="0x3fd6f" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <units>year</units>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="IF(X&gt;=128;IF((X-128)&gt;=80;(X-128)+1900;(X-128)+2000);IF(X&gt;=80;X+1900;X+2000))">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
