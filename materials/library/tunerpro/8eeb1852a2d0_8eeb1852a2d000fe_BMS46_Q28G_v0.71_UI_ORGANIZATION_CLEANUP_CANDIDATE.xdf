<XDFFORMAT version="1.80">
  <XDFHEADER>
    <flags>0x1</flags>
    <fileversion>BMS46-Q28G-FULL-v0.71-UI-ORGANIZATION-CLEANUP</fileversion>
    <deftitle>BMS46 Q28G v0.71 - organized calibration / ECU information</deftitle>
    <description>Q28G full-read XDF. v0.71 follows the successful v0.70a TunerPro write-back retest. The six requested edits encode exactly as expected in the calibration region (7 changed bytes total), with calculated calibration CRC 0xC422 before checksum repair. This pass is presentation-only: no calibration addresses, formulas, data widths, endianness, axes, raw values, bit masks or table dimensions are changed. The former Unknown / legacy folder is fully triaged into functional categories except one explicitly labeled Research / provisional item. ECU identification is split into basic ECU Information, UIF/AIF and EWS/ISN folders for a cleaner TunerPro Parameter Tree.</description>
    <author>BMS46 reproducible analysis</author>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="8" sigdigits="4" outputtype="1" signed="0" lsbfirst="0" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x40000" regioncolor="0x0" regionflags="0x0" name="Q28G full firmware" desc="Read against exact 262144-byte Q28G image only." />
    <CATEGORY index="0x0" name="Switches / toggles" />
    <CATEGORY index="0x1" name="Ignition" />
    <CATEGORY index="0x2" name="Fuel / injection" />
    <CATEGORY index="0x3" name="Torque / load / throttle" />
    <CATEGORY index="0x4" name="Idle" />
    <CATEGORY index="0x5" name="Lambda / O2 / catalyst" />
    <CATEGORY index="0x6" name="VANOS / DISA / air path" />
    <CATEGORY index="0x7" name="Knock" />
    <CATEGORY index="0x8" name="Torque reduction / protections" />
    <CATEGORY index="0x9" name="Temperature / warmup" />
    <CATEGORY index="0xA" name="Diagnostics / emissions / DTC" />
    <CATEGORY index="0xB" name="Misc scalars" />
    <CATEGORY index="0xC" name="Research / provisional" />
    <CATEGORY index="0xD" name="Deceleration / DFCO" />
    <CATEGORY index="0xE" name="Limiters / VMax" />
    <CATEGORY index="0xF" name="ECU Information" />
    <CATEGORY index="0x10" name="Integrity / Native Checksums" />
    <CATEGORY index="0x11" name="Expert / internal adaptation" />
    <CATEGORY index="0x12" name="ECU Information - UIF / AIF" />
    <CATEGORY index="0x13" name="ECU Information - EWS / ISN" />
