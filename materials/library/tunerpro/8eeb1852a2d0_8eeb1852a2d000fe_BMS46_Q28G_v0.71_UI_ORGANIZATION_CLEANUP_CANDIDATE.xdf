  <XDFCONSTANT uniqueid="0x6200" vislevel="1" flags="0xC">
    <title>INFERRED_RPM_Limiter_Alternate_Threshold</title>
    <description>[BMS46 v0.46 CODE-DERIVED] Calibration A3B0 is copied directly into FF84EA, the same active RPM-limit byte normally loaded from A3AD, when an alternate protection/state bit is active. Q28G raw=140 -&gt; 5600 RPM. Exact trigger semantics are still inferred; threshold domain is code-confirmed.</description>
    <CATEGORYMEM index="0" category="15" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0xa3b0" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
